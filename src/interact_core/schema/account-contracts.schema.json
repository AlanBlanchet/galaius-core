        },
        "password": {
          "format": "password",
          "maxLength": 1024,
          "minLength": 1,
          "title": "Password",
          "type": "string",
          "writeOnly": true
        }
      },
      "required": [
        "email",
        "password"
      ],
      "title": "LoginRequest",
      "type": "object"
    },
    "PasswordResetRequest": {
      "additionalProperties": false,
