    "LoginRequest": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "maxLength": 320,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Email",
          "type": "string"
        },
        "password": {
          "format": "password",
          "maxLength": 1024,
          "minLength": 1,
          "title": "Password",
          "type": "string",
          "writeOnly": true
        }
      },
      "required": [
        "email",
        "password"
      ],
      "title": "LoginRequest",
      "type": "object"
    },
    "PasswordResetRequest": {
      "additionalProperties": false,
      "properties": {
        "password": {
          "format": "password",
          "maxLength": 1024,
          "minLength": 12,
          "title": "Password",
          "type": "string",
          "writeOnly": true
        },
        "token": {
          "format": "password",
          "maxLength": 512,
          "minLength": 32,
          "title": "Token",
          "type": "string",
          "writeOnly": true
        }
      },
      "required": [
        "token",
        "password"
      ],
      "title": "PasswordResetRequest",
      "type": "object"
    },
    "PlatformError": {
      "additionalProperties": true,
      "properties": {
        "code": {
          "enum": [
            "authentication_failed",
            "csrf_failed",
            "invalid_origin",
            "invalid_request",
            "last_sign_in_method",
            "link_expired",
            "not_found",
            "not_linked",
            "permission_denied",
            "rate_limited",
            "verification_failed",
            "recovery_failed",
            "unavailable",
            "upgrade_required"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "PlatformError",
      "type": "object"
    },
    "PortableToolSettings": {
      "additionalProperties": true,
      "properties": {
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "values": {
          "$ref": "#/$defs/PortableToolSettingsValues"
        }
      },
      "required": [
        "revision",
        "values"
      ],
      "title": "PortableToolSettings",
      "type": "object"
    },
    "PortableToolSettingsUpdate": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "values": {
          "$ref": "#/$defs/PortableToolSettingsValues"
        }
      },
      "required": [
        "expected_revision",
        "values"
      ],
      "title": "PortableToolSettingsUpdate",
      "type": "object"
    },
    "PortableToolSettingsValues": {
      "additionalProperties": false,
      "description": "User-authored settings synced through the server: a key outside this set (a secret, a\nmachine-local path) is refused on both sides, so a new setting reaches a client with its\nrelease.",
      "properties": {
        "audio_criteria": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Criteria"
        },
        "claude_media_criteria": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claude Media Criteria"
        },
        "component_criteria": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component Criteria"
        },
        "criteria_weights": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Criteria Weights"
        },
        "detection_max_retries": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Max Retries"
        },
        "image_criteria": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Criteria"
        },
        "max_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "media_max_context_chars": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Max Context Chars"
        },
        "media_max_items": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Max Items"
        },
        "media_max_total_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Max Total Bytes"
        },
        "media_provider_order": {
          "anyOf": [
            {
              "items": {
                "const": "claude",
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Provider Order"
        },
        "media_timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Timeout"
        },
        "tier_sovereign_criteria": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier Sovereign Criteria"
        },
        "video_criteria": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Criteria"
        },
        "video_duration": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Duration"
        },
        "video_fps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Fps"
        },
        "video_max_frames": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Max Frames"
        },
        "viewport_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Viewport Height"
        },
        "viewport_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Viewport Width"
        },
        "vlm_max_dim": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vlm Max Dim"
        },
        "vlm_min_dim": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vlm Min Dim"
        },
        "wait_timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wait Timeout"
        }
      },
      "title": "PortableToolSettingsValues",
      "type": "object"
    },
    "RecoveryRequest": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "maxLength": 320,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "RecoveryRequest",
      "type": "object"
    },
    "ReleaseInfo": {
      "additionalProperties": true,
      "properties": {
        "build_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Id"
        },
        "changelog": {
          "items": {
            "$ref": "#/$defs/ChangelogEntry"
          },
          "maxItems": 100,
          "title": "Changelog",
          "type": "array"
        },
        "core_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Core Version",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "core_version",
        "changelog"
