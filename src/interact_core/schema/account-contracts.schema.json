              "pattern": "^[0-9]{14}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Siret"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
