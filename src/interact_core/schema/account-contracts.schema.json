{
  "$defs": {
    "Account": {
      "additionalProperties": true,
      "properties": {
        "account_id": {
          "format": "uuid",
          "title": "Account Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "email": {
          "maxLength": 320,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Email",
          "type": "string"
        },
        "locale": {
          "enum": [
            "en",
            "fr"
          ],
          "title": "Locale",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "account_id",
        "email",
        "locale",
        "verified"
      ],
      "title": "Account",
      "type": "object"
    },
    "AccountUpdate": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "locale": {
          "enum": [
            "en",
            "fr"
          ],
          "title": "Locale",
          "type": "string"
        }
      },
      "title": "AccountUpdate",
      "type": "object"
    },
    "Bootstrap": {
      "additionalProperties": true,
      "properties": {
        "account": {
          "$ref": "#/$defs/Account"
        },
        "csrf_token": {
          "minLength": 1,
          "title": "Csrf Token",
          "type": "string"
        },
        "current_workspace_id": {
          "format": "uuid",
          "title": "Current Workspace Id",
          "type": "string"
        },
        "session_expires_at": {
          "format": "date-time",
          "title": "Session Expires At",
          "type": "string"
        },
        "workspaces": {
          "items": {
            "$ref": "#/$defs/Workspace"
          },
          "title": "Workspaces",
          "type": "array"
        }
      },
      "required": [
        "account",
        "workspaces",
        "current_workspace_id",
        "csrf_token",
        "session_expires_at"
      ],
      "title": "Bootstrap",
      "type": "object"
    },
    "ChangelogEntry": {
      "additionalProperties": true,
      "properties": {
        "changes": {
          "items": {
            "type": "string"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        },
        "released_on": {
          "format": "date",
          "title": "Released On",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "released_on",
        "changes"
      ],
      "title": "ChangelogEntry",
      "type": "object"
    },
    "CompanyAccess": {
      "additionalProperties": true,
      "description": "What the signed-in account may do in one company: the union of its company groups \u2014 the\nSAME set the server enforces, so a client shows only controls that will be accepted.",
      "properties": {
        "groups": {
          "items": {
            "type": "string"
          },
          "title": "Groups",
          "type": "array"
        },
        "permissions": {
          "items": {
            "enum": [
              "admin.access",
              "admin.groups.manage",
              "admin.users.view",
              "admin.plans.manage",
              "admin.audit.view",
              "admin.contact.view",
              "admin.signals.view",
              "workflows.run",
              "models.platform_paid",
              "machines.pool.use",
              "machines.cloud.launch",
              "machines.reserve",
              "credits.auto_topup",
              "company.members.manage",
              "company.groups.manage",
              "company.settings.manage",
              "company.delete",
              "api_keys.manage",
              "approvals.manage",
              "billing.view",
              "billing.manage",
              "workflows.edit",
              "connections.manage",
              "accounts.connect_own",
              "agents.edit",
              "machines.manage"
            ],
            "type": "string"
          },
          "title": "Permissions",
          "type": "array"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "permissions",
        "groups"
      ],
      "title": "CompanyAccess",
      "type": "object"
    },
    "CompanyDetails": {
      "additionalProperties": true,
      "description": "Optional legal identity for an existing workspace, never a membership grant.",
      "properties": {
        "activity_code": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Code"
        },
        "address": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "city": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "country_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country Code"
        },
        "legal_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Name"
        },
        "postal_code": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postal Code"
        },
        "siret": {
          "anyOf": [
            {
              "pattern": "^[0-9]{14}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Siret"
        }
      },
      "title": "CompanyDetails",
      "type": "object"
    },
    "CompanyLogoUpload": {
      "additionalProperties": false,
      "properties": {
        "data_base64": {
          "maxLength": 1400000,
          "minLength": 1,
          "title": "Data Base64",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "expected_revision",
        "media_type",
        "data_base64"
      ],
      "title": "CompanyLogoUpload",
      "type": "object"
    },
    "CompanyLookupResult": {
      "additionalProperties": true,
      "properties": {
        "company": {
          "$ref": "#/$defs/CompanyDetails"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_url": {
          "const": "https://recherche-entreprises.api.gouv.fr",
          "default": "https://recherche-entreprises.api.gouv.fr",
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "company",
        "retrieved_at"
      ],
      "title": "CompanyLookupResult",
      "type": "object"
    },
