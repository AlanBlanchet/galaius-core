{
  "$defs": {
    "BudgetDecision": {
      "additionalProperties": true,
      "properties": {
        "measured_total_tokens": {
          "minimum": 0,
          "title": "Measured Total Tokens",
          "type": "integer"
        },
        "monthly_measured_token_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monthly Measured Token Limit"
        },
        "reason": {
          "enum": [
            "unlimited",
            "within_limit",
            "request_limit",
            "monthly_limit",
            "unmeasured_usage",
            "subscription_inactive"
          ],
          "title": "Reason",
          "type": "string"
        },
        "requested_output_tokens": {
          "minimum": 1,
          "title": "Requested Output Tokens",
          "type": "integer"
        },
        "status": {
          "enum": [
            "allowed",
            "denied",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "measured_total_tokens",
        "requested_output_tokens",
        "reason"
      ],
      "title": "BudgetDecision",
      "type": "object"
    },
    "OperatorAuditEvent": {
      "additionalProperties": true,
      "properties": {
        "action": {
          "enum": [
            "operator.provisioned",
            "account.listed",
            "workspace.listed",
            "service.inspected",
            "run_failures.listed",
            "usage.inspected",
            "plan.saved",
            "subscription.assigned",
            "usage.recorded",
            "budget.evaluated",
            "group.created",
            "group.renamed",
            "group.permissions_updated",
            "group.deleted",
            "group_member.added",
            "group_member.removed",
            "group.department_updated",
            "group.budget_set",
            "group.credential_set",
            "member.overrides_set",
            "agent.stewards_set",
            "migration.operator_accounts_migrated",
            "subscription.group_granted",
            "subscription.group_revoked",
            "contact_message.listed",
            "contact_message.read",
            "contact_message.deleted",
            "signal.listed",
            "signal.status_changed",
            "signal.deleted",
            "error_report.listed",
            "error_report.read",
            "error_report.status_changed",
            "error_report.deleted",
            "machine_agent.started",
            "machine_agent.messaged",
            "machine_agent.stopped",
            "machine_agent.compacted",
            "machine_agent.answered",
            "machine_agent.continued",
            "machine_agent.provider_switched",
            "machine_agent.settings_changed",
            "machine_agent.workspace_prepared",
            "machine_agent.program_installed",
            "machine_agent.sign_in_code_handed",
            "machine_agent.subscription_signed_out",
            "machine_agent.allowance_given",
            "machine_agent.moved",
            "machine_agent.web_limit_changed",
            "project_secret.set",
            "project_secret.deleted",
            "project_secret.delivered",
            "machine_place.level_changed",
            "machine_place.widening_requested",
            "machine_place.widening_withdrawn",
            "machine_place.review_discarded",
            "machine.access_set",
            "member.access_changed",
            "member.invited",
            "member.removed"
          ],
          "title": "Action",
          "type": "string"
        },
        "actor_account_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Account Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "target_kind": {
          "enum": [
            "account",
            "workspace",
            "service",
            "run",
            "plan",
            "subscription",
            "usage",
            "group",
            "group_member",
            "migration",
            "contact_message",
            "signal",
            "error_report",
            "machine",
            "agent",
            "project"
          ],
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "action",
        "target_kind",
        "created_at"
      ],
      "title": "OperatorAuditEvent",
      "type": "object"
    },
    "OperatorAuthority": {
      "additionalProperties": true,
      "properties": {
        "account_id": {
          "format": "uuid",
          "title": "Account Id",
          "type": "string"
        },
        "authorized": {
          "const": true,
          "title": "Authorized",
          "type": "boolean"
        },
        "permissions": {
          "default": [],
          "items": {
            "enum": [
              "admin.access",
              "admin.groups.manage",
              "admin.users.view",
              "admin.plans.manage",
              "admin.audit.view",
              "admin.contact.view",
              "admin.signals.view",
              "agents.view",
              "agents.run",
              "workflows.run",
              "agents.edit",
              "prompts.edit",
              "tools.manage",
              "workflows.edit",
              "connections.manage",
              "accounts.connect_own",
              "machines.manage",
              "billing.view",
              "billing.manage",
              "approvals.manage",
              "api_keys.manage",
              "company.members.manage",
              "company.groups.manage",
              "company.settings.manage",
              "company.delete",
              "models.platform_paid",
              "machines.pool.use",
              "machines.cloud.launch",
              "machines.reserve",
              "credits.auto_topup"
            ],
            "type": "string"
          },
          "title": "Permissions",
          "type": "array"
        },
        "provisioned_at": {
          "format": "date-time",
          "title": "Provisioned At",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "authorized",
        "provisioned_at"
      ],
      "title": "OperatorAuthority",
      "type": "object"
    },
    "OperatorRunFailure": {
      "additionalProperties": true,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "failed",
            "cancelled",
            "interrupted"
          ],
          "title": "Status",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "run_id",
        "status",
        "created_at",
        "updated_at"
      ],
      "title": "OperatorRunFailure",
      "type": "object"
    },
    "OperatorServiceSummary": {
      "additionalProperties": true,
      "properties": {
        "account_count": {
          "minimum": 0,
          "title": "Account Count",
          "type": "integer"
        },
        "failed_run_count": {
          "minimum": 0,
          "title": "Failed Run Count",
          "type": "integer"
        },
        "operator_count": {
          "minimum": 0,
          "title": "Operator Count",
          "type": "integer"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "workspace_count": {
          "minimum": 0,
          "title": "Workspace Count",
          "type": "integer"
        }
      },
      "required": [
        "account_count",
        "workspace_count",
        "operator_count",
        "failed_run_count",
        "recorded_at"
      ],
      "title": "OperatorServiceSummary",
      "type": "object"
    },
    "OperatorWorkspaceSummary": {
      "additionalProperties": true,
      "properties": {
        "membership_count": {
          "minimum": 0,
          "title": "Membership Count",
          "type": "integer"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "subscription": {
          "$ref": "#/$defs/WorkspaceSubscription"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "name",
        "membership_count",
        "subscription"
      ],
      "title": "OperatorWorkspaceSummary",
      "type": "object"
    },
    "SubscriptionLimit": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "minimum": 1,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "SubscriptionLimit",
      "type": "object"
    },
    "SubscriptionPlanDefinition": {
      "additionalProperties": true,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "entitlements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Entitlements",
          "type": "array"
        },
        "granted_group_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Granted Group Id"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "limits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SubscriptionLimit"
          },
          "maxItems": 64,
          "title": "Limits",
          "type": "array"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_revision": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Revision"
        },
        "price_usd_monthly": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Usd Monthly"
        },
        "revision": {
          "format": "uuid",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "created_at"
      ],
      "title": "SubscriptionPlanDefinition",
      "type": "object"
    },
    "SubscriptionPlanRef": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "format": "uuid",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "SubscriptionPlanRef",
      "type": "object"
    },
    "TokenCounts": {
      "additionalProperties": true,
      "description": "Tokens one model call used, or a sum of calls: `input` the prompt tokens neither read from nor written to a cache\n(the full input rate), `cache_read` / `cache_write` the cached rest of the prompt (each at its own rate), `output`\nthe reply, reasoning included (`reasoning` the part of it a vendor names apart). Anthropic reports this shape\nnatively; OpenAI and Gemini count cached tokens inside their prompt figure: carved out at the edge reading their\nresponse, never counted twice. A figure nothing reported is None, never a synthetic zero.",
      "properties": {
        "cache_read": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read"
        },
        "cache_write": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write"
        },
        "input": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input"
        },
        "output": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "reasoning": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        }
      },
      "title": "TokenCounts",
      "type": "object"
    },
    "UsageProvenanceSummary": {
      "additionalProperties": true,
      "properties": {
        "estimated": {
          "$ref": "#/$defs/UsageTotals"
        },
        "measured": {
          "$ref": "#/$defs/UsageTotals"
        },
        "period_start": {
          "format": "date-time",
          "title": "Period Start",
          "type": "string"
        },
        "unknown_calls": {
          "minimum": 0,
          "title": "Unknown Calls",
          "type": "integer"
        }
      },
      "required": [
        "measured",
        "estimated",
        "unknown_calls",
        "period_start"
      ],
      "title": "UsageProvenanceSummary",
      "type": "object"
    },
    "UsageRecord": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "measured",
            "estimated",
            "unknown"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/UsageSourceRef"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenCounts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "source",
        "provenance",
        "recorded_at"
      ],
      "title": "UsageRecord",
      "type": "object"
    },
    "UsageSourceRef": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "conversation",
            "workflow"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provider_response_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Response Id"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "UsageSourceRef",
      "type": "object"
    },
    "UsageTotals": {
      "additionalProperties": true,
      "description": "What a period's calls of one provenance used, summed (`TokenCounts.sum`).",
      "properties": {
        "calls": {
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "usage": {
          "$ref": "#/$defs/TokenCounts"
        }
      },
      "required": [
        "usage",
        "calls"
      ],
      "title": "UsageTotals",
      "type": "object"
    },
    "WorkspaceSubscription": {
      "additionalProperties": true,
      "properties": {
        "assigned_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assigned At"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubscriptionPlanRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "unconfigured",
            "active",
            "suspended",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "status",
        "updated_at"
      ],
      "title": "WorkspaceSubscription",
      "type": "object"
    },
    "WorkspaceSubscriptionUpdate": {
      "additionalProperties": false,
      "properties": {
        "plan": {
          "$ref": "#/$defs/SubscriptionPlanRef"
        },
        "status": {
          "enum": [
            "active",
            "suspended",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "plan",
        "status"
      ],
      "title": "WorkspaceSubscriptionUpdate",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/BudgetDecision"
    },
    {
      "$ref": "#/$defs/OperatorAuditEvent"
    },
    {
      "$ref": "#/$defs/OperatorAuthority"
    },
    {
      "$ref": "#/$defs/OperatorRunFailure"
    },
    {
      "$ref": "#/$defs/OperatorServiceSummary"
    },
    {
      "$ref": "#/$defs/OperatorWorkspaceSummary"
    },
    {
      "$ref": "#/$defs/SubscriptionPlanDefinition"
    },
    {
      "$ref": "#/$defs/UsageProvenanceSummary"
    },
    {
      "$ref": "#/$defs/UsageRecord"
    },
    {
      "$ref": "#/$defs/WorkspaceSubscription"
    },
    {
      "$ref": "#/$defs/WorkspaceSubscriptionUpdate"
    }
  ]
}
