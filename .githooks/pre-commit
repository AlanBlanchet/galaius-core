#!/usr/bin/env bash
# Tracked git hook (configured via `git config core.hooksPath .githooks`).
set -e

# 0) Public repository: no private material in a commit (the pre-push hook re-checks at push time).
#    Added lines only; terms live in <git-common-dir>/info/private-terms (.githooks/private-terms.sh).
. "$(dirname "$0")/private-terms.sh"
_added="$(git diff --cached --no-color -U0 | grep -E '^\+' | grep -Ev '^\+\+\+' || true)"
_private="$(printf '%s\n' "$_added" | grep -E '/home/[a-z_][a-z0-9_-]*/|"slash''_commands"' || true)"
_private="${_private}$(printf '%s\n' "$_added" | private_hits "$(private_terms)")"
if [ -n "$(printf '%s' "$_private" | tr -d '[:space:]')" ]; then
    echo "[hook] FAIL: private material in a public repository commit:"
    printf '%s\n' "$_private" | head -5 | cut -c1-160
    exit 1
fi
